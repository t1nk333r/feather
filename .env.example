# Copy to .env and fill in. Never commit the real .env.

# Required
ADMIN_PASSWORD=

# Optional
PORT=
SECRET_KEY=
MAX_CONTENT_LENGTH=
RATE_LIMIT=

# Added by plans 001 / 008
DATA_DIR=
PUBLIC_BASE_URL=

# Added by plans 011 / 028 -- IPA and owned app-icon storage backend.
# Defaults to "local" (today's behaviour); the GARAGE_* variables below are
# only required if this is set to "garage".
STORAGE_BACKEND=
GARAGE_S3_ENDPOINT=
GARAGE_S3_REGION=
GARAGE_S3_ACCESS_KEY_ID=
GARAGE_S3_SECRET_ACCESS_KEY=
GARAGE_BUCKET=
GARAGE_PUBLIC_BASE_URL=
GARAGE_KEY_PREFIX=

# Added by plan 066 -- optional. Lets icons use a different backend than
# IPAs. Defaults to STORAGE_BACKEND if unset. Example: IPAs on Garage but
# icons pinned to local disk at /app/data/icons (already a mounted volume
# in compose.yml):
#   STORAGE_BACKEND=garage
#   ICON_STORAGE_BACKEND=local
ICON_STORAGE_BACKEND=

# Added by plan 013 -- self-hosted Bot API server + forward-to-bot IPA
# ingest. All required by scripts/telegram_bot_ingest.py; it refuses to
# start if any is unset. TELEGRAM_ALLOWED_USER_IDS is a comma-separated
# list of numeric Telegram user ids and must not be empty -- an empty
# allowlist is a fatal error, not "allow everyone".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
BOT_API_BASE_URL=
BOT_API_FILE_ROOT=
FEATHER_BASE_URL=
FEATHER_ADMIN_PASSWORD=

# Added by plan 020 -- optional; getFile blocks for the entire download in
# --local mode, so this needs to be a generous ceiling, not a normal
# request timeout. Defaults to 900 seconds if unset.
BOT_API_GETFILE_TIMEOUT=

# Added by plan 023 -- optional. developerName has no reliable source in
# an IPA, so this is used when the bot creates a catalog entry. Defaults
# to "Unknown" if unset; the operator can correct it in the web UI.
TELEGRAM_DEFAULT_DEVELOPER=

# Added by plan 014 -- optional Telegram notification on catalog changes.
# Disabled unless TELEGRAM_BOT_TOKEN (above) and the chat id below are
# both set. The events variable is a comma-separated list of events to
# notify on; defaults to "add_app,add_version,delete_app" if unset.
# BOT_API_BASE_URL (above) is reused as the Telegram Bot API base if
# plan 013 has landed.
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_NOTIFY_EVENTS=

# Added by plan 029 -- optional one-shot cron release importer
# (scripts/release_source_ingest.py / the `release-import` Compose
# service). Polls a configured GitHub/GitLab repository's releases and
# publishes new IPAs to feather through FEATHER_BASE_URL /
# FEATHER_ADMIN_PASSWORD above -- it never touches source.json, IPAs, or
# icons directly. Dry-run (no downloads, no publish, no state write) is
# the default; the service only downloads/publishes when invoked with
# --apply. GITHUB_TOKEN / GITLAB_TOKEN are entirely optional for public
# repositories -- set them only for a private repository, and only with
# read-only scope. Neither ever belongs in release-sources.json.
RELEASE_IMPORT_CONFIG=
RELEASE_IMPORT_STATE=
RELEASE_IMPORT_TIMEOUT=
RELEASE_IMPORT_MAX_BYTES=
GITHUB_TOKEN=
GITLAB_TOKEN=
