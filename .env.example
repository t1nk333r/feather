# Copy to .env and fill in. Never commit the real .env.

# Required
ADMIN_PASSWORD=

# Optional
PORT=
SECRET_KEY=
MAX_CONTENT_LENGTH=
RATE_LIMIT=

# Added by plans 001 / 008
DATA_DIR=
PUBLIC_BASE_URL=

# Added by plan 011 -- IPA storage backend. Defaults to "local" (today's
# behaviour); the GARAGE_* variables below are only required if this is
# set to "garage".
STORAGE_BACKEND=
GARAGE_S3_ENDPOINT=
GARAGE_S3_REGION=
GARAGE_S3_ACCESS_KEY_ID=
GARAGE_S3_SECRET_ACCESS_KEY=
GARAGE_BUCKET=
GARAGE_PUBLIC_BASE_URL=
GARAGE_KEY_PREFIX=

# Added by plan 013 -- self-hosted Bot API server + forward-to-bot IPA
# ingest. All required by scripts/telegram_bot_ingest.py; it refuses to
# start if any is unset. TELEGRAM_ALLOWED_USER_IDS is a comma-separated
# list of numeric Telegram user ids and must not be empty -- an empty
# allowlist is a fatal error, not "allow everyone".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
BOT_API_BASE_URL=
BOT_API_FILE_ROOT=
FEATHER_BASE_URL=
FEATHER_ADMIN_PASSWORD=

# Added by plan 020 -- optional; getFile blocks for the entire download in
# --local mode, so this needs to be a generous ceiling, not a normal
# request timeout. Defaults to 900 seconds if unset.
BOT_API_GETFILE_TIMEOUT=
