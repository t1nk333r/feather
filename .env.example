# Copy to .env and fill in. Never commit the real .env.

# Required
ADMIN_PASSWORD=

# Optional
PORT=
SECRET_KEY=
MAX_CONTENT_LENGTH=
RATE_LIMIT=

# Added by plans 001 / 008
DATA_DIR=
PUBLIC_BASE_URL=

# Added by plan 011 -- IPA storage backend. Defaults to "local" (today's
# behaviour); the GARAGE_* variables below are only required if this is
# set to "garage".
STORAGE_BACKEND=
GARAGE_S3_ENDPOINT=
GARAGE_S3_REGION=
GARAGE_S3_ACCESS_KEY_ID=
GARAGE_S3_SECRET_ACCESS_KEY=
GARAGE_BUCKET=
GARAGE_PUBLIC_BASE_URL=
GARAGE_KEY_PREFIX=
