# Plan 073: the fdroid-index sidecar. The official fdroidserver image plus
# one loop script. Runs as root by necessity -- see scripts/fdroid_index_loop.sh.
# Pinned by digest because the upstream `master` tag is mutable. Refresh by
# rerunning the real-APK init/update spike, then recording the new digest and
# fdroid version here. GitLab purges old digests when `master` is rebuilt --
# the 2026-08-28 pin (e5853810) vanished on 2026-09-19 and broke the build.
# The 2026-09-19 pin (63d73424, fdroid 3cbbe810) was purged in turn and
# answered MANIFEST_UNKNOWN on 2026-09-30.
# This pin: tag: master as of 2026-09-30. The image config (and so its
# revision label) could not be fetched from the review environment; master
# HEAD was a35fdfdd (2026-09-14). The real-APK spike was run 2026-09-30 with
# fdroidserver 3cbbe810 AND a35fdfdd from source, driving this repo's loop
# script and AndroidRepoManager.add_apk: new apps and newer versions publish
# into index-v1/v2 + entry.jar; unsigned APKs are skipped and bad-signature
# APKs archived, both with exit 0 (see `rejected` in last-update.json).
FROM registry.gitlab.com/fdroid/docker-executable-fdroidserver@sha256:e13f368211de9fc7ebbe321858f23cb619f0155277b9b8b52e2027e2cb9318ba
COPY scripts/fdroid_index_loop.sh /usr/local/bin/fdroid-index-loop
RUN chmod 755 /usr/local/bin/fdroid-index-loop
WORKDIR /repo
ENTRYPOINT ["/bin/sh", "/usr/local/bin/fdroid-index-loop"]
