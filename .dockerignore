# Deny by default, then re-admit only what the Dockerfiles COPY.
# Rationale: this file's job is to make a future `COPY . .` harmless.
# Anything not explicitly re-admitted below cannot reach an image layer,
# which matters because the published packages are (or will be) public.
*

# Dockerfile needs these
!requirements.txt
!app.py
!templates/
!static/

# Dockerfile.bot needs this one script -- do NOT blanket-exclude scripts/
!scripts/telegram_bot_ingest.py

# Dockerfile (main image) needs this one script for the opt-in release
# importer (Plan 029) -- same rule, do NOT blanket-exclude scripts/
!scripts/release_source_ingest.py

# Shared by the Telegram and release importers; both published images must
# receive it alongside their executable script.
!scripts/ipa_inspection.py

# Dockerfile.fdroid needs this one script for the opt-in Android/F-Droid
# sidecar (Plan 073) -- same rule, do NOT blanket-exclude scripts/
!scripts/fdroid_index_loop.sh

# Belt and braces: even if something above is loosened later, these must
# never enter a build context.
.env
.env.*
data/
.git/
.claude/
.venv/
venv/
__pycache__/
*.pyc
